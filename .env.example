# Local development only. Copy to .env and replace passwords before use.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=price_lens
POSTGRES_USER=price_lens
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://price_lens:change-me-local-only@localhost:5432/price_lens
TEST_DATABASE_URL=postgresql+psycopg://price_lens:change-me-local-only@localhost:5432/price_lens_test
TEXT2SQL_DATABASE_URL=postgresql+psycopg://price_lens_text2sql:change-me-text2sql-local-only@localhost:5432/price_lens
TEXT2SQL_ROLE_NAME=price_lens_text2sql
TEXT2SQL_STATEMENT_TIMEOUT_MS=2000
TEXT2SQL_LOCK_TIMEOUT_MS=500
TEXT2SQL_MAX_ROWS=100
TEXT2SQL_MAX_EXPLAIN_COST=100000
AI_PROVIDER=rules
AI_MODEL=price-lens-rules-v1

MOA_API_BASE_URL=https://data.moa.gov.tw/api/v1
MOA_REQUEST_TIMEOUT_SECONDS=30
MOA_MAX_CONCURRENCY=5
MOA_MAX_RETRIES=3
MOA_ETL_CHUNK_DAYS=31

# Server-side URL used by the Next.js frontend. For Docker Compose this is
# overridden to the internal service URL http://api:8000.
PRICE_LENS_API_URL=http://localhost:8000
